#!/bin/bash
set -e
engine_dir=/opt/picochess/engines/mame_emulation
cd "$engine_dir"
# picochess passes its MAME options (speed, sound) in the first argument.
read -r -a options <<< "${1:-}"
# Headless, with the arm's mechanical sounds (MechanicalSound/novag_audio.py).
SDL_VIDEODRIVER=dummy exec python3 "$engine_dir/MechanicalSound/novag_audio.py" -- \
    "$engine_dir/mess" "${options[@]}" "${@:2}" \
    -video none -plugins -plugin chessengine,novagsound robotadv
